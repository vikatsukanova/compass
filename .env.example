# Neon
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth — required locally AND on Vercel (Production environment)
# Generate secret: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
AUTH_EMAIL="you@example.com"
AUTH_PASSWORD="choose-a-strong-password"

# Public demo (optional — use a separate Neon database, never your personal one):
# AUTH_EMAIL="demo@compass.app"
# AUTH_PASSWORD="compass-demo"
# Database name must be compass_demo. Then: npm run db:migrate:deploy && npm run db:seed:demo

# Optional on Vercel when using a custom domain:
# AUTH_URL="https://your-domain.com"
